<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both of these are shown by iOS in its own language, except that they are
	     not: localising them means adding InfoPlist.strings catalogues to the
	     generated Xcode project under src-tauri/gen/apple. -->
	<!-- Shown when the wallet asks to unlock with Face ID. -->
	<key>NSFaceIDUsageDescription</key>
	<string>The Almena ID wallet unlocks with Face ID.</string>
	<!-- Shown when the wallet asks for the camera to read a QR code. -->
	<key>NSCameraUsageDescription</key>
	<string>The Almena ID wallet uses the camera to read QR codes.</string>
	<!-- What turns the wallet's own Documents directory into a folder in the
	     Files app, under "On My iPhone". The Files app walks the whole tree, so
	     `Documents/logs` shows as a folder inside it and the gathered export sits
	     at the top where one tap reaches it. **The folder only appears once
	     Documents holds something**, which the first export is what does.

	     Tauri itself still has no share sheet; the wallet reaches one through a
	     third-party plugin, and this stays the way somebody gets at the log
	     without one. Only the log is written here. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- The scene lifecycle, declared so that the wallet launches at all.

	     UIKit on the iOS 27 SDK refuses to start an application that has not
	     adopted UIScene: the launch-time check reads this manifest, and only
	     this manifest, and traps (EXC_BREAKPOINT in
	     _UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption) when it
	     finds none. It gives no credit to a delegate that answers
	     `application:configurationForConnectingSceneSession:options:` at
	     runtime — which is what tao, the window layer under Tauri, does.

	     tao installs that delegate only when this manifest says the
	     application supports multiple scenes, so the flag is true even though
	     the wallet wants exactly one window: an iPad then offers a second one,
	     and `src/scene.rs` is what turns it down. The configuration names
	     tao's own scene delegate class, so the static entry and the runtime one
	     point at the same object. See tauri-apps/tauri#15719.

	     Tauri 2.11 pins tao 0.35, which cannot be told otherwise; tao 0.37
	     answers the session role regardless of this flag, and the day Tauri
	     reaches it the flag can go back to false. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>TaoSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- A phone is held one way and a wallet is read one way: the approval
	     screen, the keypad and the twelve words are all a column, and there is
	     nothing on any of them that a landscape phone would show more of. A
	     tablet is a different object — held either way on purpose — so it keeps
	     both, which is what the `~ipad` variant of this key is for.

	     Declared here as well as in the generated project because the generated
	     project is regenerated by `tauri ios init` and this file is not. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
