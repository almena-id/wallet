<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later: what the system copies to the cloud backup and to a new
  phone. The vault's record, and the copy of its key biometrics open, are left
  out of both: each is sealed under a key in this phone's Keystore, which never
  travels, so a copy anywhere else could not be opened — and would only stand between somebody and restoring from their
  phrase. Everything else the wallet writes is sealed under the seed and comes
  back once the phrase does. Copied into gen/android by push/sync.sh.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="vault.json" />
        <exclude domain="root" path="vault.json.writing" />
        <exclude domain="root" path="vault.biometric" />
        <exclude domain="root" path="vault.biometric.writing" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="vault.json" />
        <exclude domain="root" path="vault.json.writing" />
        <exclude domain="root" path="vault.biometric" />
        <exclude domain="root" path="vault.biometric.writing" />
    </device-transfer>
</data-extraction-rules>
