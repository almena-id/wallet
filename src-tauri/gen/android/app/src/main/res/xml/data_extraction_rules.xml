<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later read this instead of android:allowBackup. Both the cloud
  backup and the device-to-device transfer are refused outright: what this
  application keeps is an identity, and the only copy of it that is meant to
  leave a device is the twelve words its owner wrote down.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
