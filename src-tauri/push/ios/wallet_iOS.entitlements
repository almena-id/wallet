<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs. "development" for the builds Xcode signs here; exporting for
	     distribution re-signs it as "production". -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: https://almena.id/w/… opens the wallet, which
	     almena.id names in /.well-known/apple-app-site-association. The
	     deep-link plugin writes the same from tauri.conf.json at build. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:almena.id</string>
	</array>
</dict>
</plist>
