{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Almena Wallet",
  "version": "0.1.0",
  "identifier": "id.almena.wallet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Almena Wallet",
        "width": 1280,
        "height": 720,
        "minWidth": 380,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f2f3f6",
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "almena"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "almena"
        ]
      }
    }
  }
}
